# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
AnimaTales2D/[Ll]ibrary/
AnimaTales2D/[Tt]emp/
AnimaTales2D/[Oo]bj/
AnimaTales2D/[Bb]uild/
AnimaTales2D/[Bb]uilds/
AnimaTales2D/[Ll]ogs/
AnimaTales2D/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
AnimaTales2D/[Mm]emoryCaptures/

# Recordings can get excessive in size
AnimaTales2D/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
AnimaTales2D/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
AnimaTales2D/.vs/

# Gradle cache directory
AnimaTales2D/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
AnimaTales2D/ExportedObj/
AnimaTales2D/.consulo/
AnimaTales2D/*.csproj
AnimaTales2D/*.unityproj
AnimaTales2D/*.sln
AnimaTales2D/*.suo
AnimaTales2D/*.tmp
AnimaTales2D/*.user
AnimaTales2D/*.userprefs
AnimaTales2D/*.pidb
AnimaTales2D/*.booproj
AnimaTales2D/*.svd
AnimaTales2D/*.pdb
AnimaTales2D/*.mdb
AnimaTales2D/*.opendb
AnimaTales2D/*.VC.db

# Unity3D generated meta files
AnimaTales2D/*.pidb.meta
AnimaTales2D/*.pdb.meta
AnimaTales2D/*.mdb.meta

# Unity3D generated file on crash reports
AnimaTales2D/sysinfo.txt

# Builds
AnimaTales2D/*.apk
AnimaTales2D/*.aab
AnimaTales2D/*.unitypackage
AnimaTales2D/*.unitypackage.meta
AnimaTales2D/*.app

# Crashlytics generated file
AnimaTales2D/crashlytics-build.properties

# Packed Addressables
AnimaTales2D/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
AnimaTales2D/[Aa]ssets/[Ss]treamingAssets/aa.meta
AnimaTales2D/[Aa]ssets/[Ss]treamingAssets/aa/*

AnimaTales2D/.idea